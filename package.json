{
  "name": "portfolio-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:responsive": "next build && node scripts/check-responsive.mjs",
    "check:cls": "next build && node scripts/check-responsive.mjs --cls",
    "check:a11y": "next build && node scripts/check-a11y.mjs",
    "check:navigation": "next build && node scripts/check-navigation.mjs",
    "check:results": "next build && node scripts/check-results.mjs",
    "results": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/results.mjs",
    "check": "npm run lint && next build && node scripts/check-results.mjs && node scripts/check-navigation.mjs && node scripts/check-a11y.mjs && node scripts/check-responsive.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "clsx": "^2.1.1",
    "motion": "^14.9.1",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "axe-core": "^4.10.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "playwright-core": "^1.49.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
